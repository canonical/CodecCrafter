{
  "videos": [
    {
      "resolution": "1080p",
      "fps": 30,
      "codec": "h264",
      "duration": 10
    },
    {
      "resolution": "1080p",
      "fps": 60,
      "codec": "h265",
      "duration": 10,
      "bitrate": "50M"
    },
    {
      "resolution": "2160p",
      "fps": 30,
      "codec": "vp9",
      "duration": 10,
      "bitrate_formula": "width * height * fps * 0.15"
    },
    {
      "resolution": "4K",
      "fps": 30,
      "codec": "h265",
      "duration": 10,
      "output_filename": "custom_4k_video.mp4"
    }
  ],
  "defaults": {
    "pix_fmt": "yuv420p",
    "test_pattern": "testsrc2",
    "preset": "veryslow",
    "output_dir": "video"
  },
  "bitrate_formula": "width * height * fps * 0.1"
}
