{
  "videos": [
    {
      "resolution": "1080p",
      "fps": 30,
      "codec": "av1",
      "duration": 10
    },
    {
      "resolution": "2160p",
      "fps": 30,
      "codec": "av1",
      "duration": 10,
      "bitrate": "80M"
    },
    {
      "resolution": "4K",
      "fps": 60,
      "codec": "av1",
      "duration": 10
    }
  ],
  "defaults": {
    "pix_fmt": "yuv420p",
    "test_pattern": "testsrc2",
    "preset": "veryslow"
  },
  "bitrate_formula": "width * height * fps * 0.12"
}
